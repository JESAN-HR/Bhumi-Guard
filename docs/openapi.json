              },
              {
                "type": "null"
              }
            ],
            "title": "Holding Id"
          },
          "mouza_id": {
            "type": "string",
            "maxLength": 80,
            "title": "Mouza Id"
          },
          "survey": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Survey"
          },
          "dag": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Dag"
          },
          "area": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ],
            "title": "Area"
          },
          "date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date"
          },
          "unit": {
            "type": "string",
            "const": "decimal",
            "title": "Unit",
            "default": "decimal"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "mouza_id"
        ],
        "title": "Fields"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "NewCase": {
        "properties": {
          "scenario_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scenario Id"
          },
          "mouza_id": {
            "type": "string",
            "title": "Mouza Id"
          },
          "fictional": {
            "type": "boolean",
            "title": "Fictional"
          }
        },
        "type": "object",
        "required": [
          "mouza_id",
          "fictional"
        ],
        "title": "NewCase"
      },
      "ReviewDecision": {
        "properties": {
          "analysis_id": {
            "type": "string",
            "title": "Analysis Id"
          },
          "action": {
            "type": "string",
            "enum": [
              "reviewed",
              "more_information"
            ],
            "title": "Action"
          },
          "notes": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 5,
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "analysis_id",
          "action",
          "notes"
        ],
        "title": "ReviewDecision"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
