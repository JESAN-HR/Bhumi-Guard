# Copy to .env for Docker Compose. Set your own local credentials.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DEMO_USERNAME=reviewer
DEMO_PASSWORD=replace-with-your-own-12-character-password
APP_ENV=local
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
# Optional; only explicit extraction clicks send documents to this provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Non-Docker PostgreSQL example (shell environment, not auto-loaded):
# DATABASE_URL=postgresql+psycopg://bhumiguard:YOUR_PASSWORD@localhost:5432/bhumiguard
